{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://knowledge-grounded-assistant.example/contracts/knowledge-document/v1",
    "title":  "Governed knowledge document record",
    "type":  "object",
    "additionalProperties":  false,
    "properties":  {
                       "schemaVersion":  {
                                             "const":  1
                                         },
                       "id":  {
                                  "type":  "string",
                                  "pattern":  "^knowledge_[a-z0-9-]{3,80}$"
                              },
                       "status":  {
                                      "enum":  [
                                                   "draft",
                                                   "needs_review",
                                                   "approved",
                                                   "rejected",
                                                   "superseded"
                                               ]
                                  },
                       "title":  {
                                     "type":  "string",
                                     "minLength":  1,
                                     "maxLength":  300
                                 },
                       "language":  {
                                        "type":  "string",
                                        "pattern":  "^[a-z]{2,3}(-[A-Z]{2})?$"
                                    },
                       "tags":  {
                                    "type":  "array",
                                    "minItems":  1,
                                    "maxItems":  100,
                                    "uniqueItems":  true,
                                    "items":  {
                                                  "type":  "string",
                                                  "minLength":  1,
                                                  "maxLength":  80
                                              }
                                },
                       "topics":  {
                                      "type":  "array",
                                      "minItems":  1,
                                      "maxItems":  100,
                                      "uniqueItems":  true,
                                      "items":  {
                                                    "type":  "string",
                                                    "minLength":  1,
                                                    "maxLength":  120
                                                }
                                  },
                       "sourceRefs":  {
                                          "type":  "array",
                                          "minItems":  1,
                                          "maxItems":  100,
                                          "items":  {
                                                        "type":  "object",
                                                        "additionalProperties":  false,
                                                        "properties":  {
                                                                           "sourceId":  {
                                                                                            "type":  "string",
                                                                                            "pattern":  "^source_[a-f0-9]{16,64}$"
                                                                                        },
                                                                           "sourceContentSha256":  {
                                                                                                       "type":  "string",
                                                                                                       "pattern":  "^[a-f0-9]{64}$"
                                                                                                   },
                                                                           "segmentIds":  {
                                                                                              "type":  "array",
                                                                                              "minItems":  1,
                                                                                              "maxItems":  1000,
                                                                                              "uniqueItems":  true,
                                                                                              "items":  {
                                                                                                            "type":  "string",
                                                                                                            "pattern":  "^segment_[a-f0-9]{16,64}$"
                                                                                                        }
                                                                                          }
                                                                       },
                                                        "required":  [
                                                                         "sourceId",
                                                                         "sourceContentSha256",
                                                                         "segmentIds"
                                                                     ]
                                                    }
                                      },
                       "claims":  {
                                      "type":  "array",
                                      "minItems":  1,
                                      "maxItems":  500,
                                      "items":  {
                                                    "type":  "object",
                                                    "additionalProperties":  false,
                                                    "properties":  {
                                                                       "id":  {
                                                                                  "type":  "string",
                                                                                  "pattern":  "^claim_[a-z0-9-]{3,80}$"
                                                                              },
                                                                       "text":  {
                                                                                    "type":  "string",
                                                                                    "minLength":  1,
                                                                                    "maxLength":  4000
                                                                                },
                                                                       "evidenceRefs":  {
                                                                                            "type":  "array",
                                                                                            "minItems":  1,
                                                                                            "maxItems":  100,
                                                                                            "items":  {
                                                                                                          "type":  "object",
                                                                                                          "additionalProperties":  false,
                                                                                                          "properties":  {
                                                                                                                             "sourceId":  {
                                                                                                                                              "type":  "string",
                                                                                                                                              "pattern":  "^source_[a-f0-9]{16,64}$"
                                                                                                                                          },
                                                                                                                             "segmentIds":  {
                                                                                                                                                "type":  "array",
                                                                                                                                                "minItems":  1,
                                                                                                                                                "maxItems":  1000,
                                                                                                                                                "items":  {
                                                                                                                                                              "type":  "string",
                                                                                                                                                              "pattern":  "^segment_[a-f0-9]{16,64}$"
                                                                                                                                                          }
                                                                                                                                            }
                                                                                                                         },
                                                                                                          "required":  [
                                                                                                                           "sourceId",
                                                                                                                           "segmentIds"
                                                                                                                       ]
                                                                                                      }
                                                                                        }
                                                                   },
                                                    "required":  [
                                                                     "id",
                                                                     "text",
                                                                     "evidenceRefs"
                                                                 ]
                                                }
                                  },
                       "relationships":  {
                                             "type":  "array",
                                             "maxItems":  200,
                                             "items":  {
                                                           "type":  "object",
                                                           "additionalProperties":  false,
                                                           "properties":  {
                                                                              "type":  {
                                                                                           "enum":  [
                                                                                                        "related_to",
                                                                                                        "prerequisite_for",
                                                                                                        "clarifies",
                                                                                                        "supersedes",
                                                                                                        "conflicts_with"
                                                                                                    ]
                                                                                       },
                                                                              "targetDocumentId":  {
                                                                                                       "type":  "string",
                                                                                                       "pattern":  "^knowledge_[a-z0-9-]{3,80}$"
                                                                                                   },
                                                                              "evidenceClaimIds":  {
                                                                                                       "type":  "array",
                                                                                                       "minItems":  1,
                                                                                                       "maxItems":  100,
                                                                                                       "items":  {
                                                                                                                     "type":  "string",
                                                                                                                     "pattern":  "^claim_[a-z0-9-]{3,80}$"
                                                                                                                 }
                                                                                                   }
                                                                          },
                                                           "required":  [
                                                                            "type",
                                                                            "targetDocumentId",
                                                                            "evidenceClaimIds"
                                                                        ]
                                                       }
                                         },
                       "review":  {
                                      "type":  "object",
                                      "additionalProperties":  false,
                                      "properties":  {
                                                         "aiAdministrator":  {
                                                                                 "type":  "string",
                                                                                 "minLength":  1,
                                                                                 "maxLength":  120
                                                                             },
                                                         "privacyReviewed":  {
                                                                                 "type":  "boolean"
                                                                             },
                                                         "freshnessReviewed":  {
                                                                                   "type":  "boolean"
                                                                               },
                                                         "authorityReviewed":  {
                                                                                   "type":  "boolean"
                                                                               },
                                                         "humanReviewStatus":  {
                                                                                   "enum":  [
                                                                                                "pending",
                                                                                                "approved",
                                                                                                "rejected"
                                                                                            ]
                                                                               },
                                                         "approvedBy":  {
                                                                            "type":  [
                                                                                         "string",
                                                                                         "null"
                                                                                     ],
                                                                            "maxLength":  120
                                                                        },
                                                         "approvedAt":  {
                                                                            "type":  [
                                                                                         "string",
                                                                                         "null"
                                                                                     ],
                                                                            "format":  "date-time"
                                                                        }
                                                     },
                                      "required":  [
                                                       "aiAdministrator",
                                                       "privacyReviewed",
                                                       "freshnessReviewed",
                                                       "authorityReviewed",
                                                       "humanReviewStatus",
                                                       "approvedBy",
                                                       "approvedAt"
                                                   ]
                                  },
                       "createdAt":  {
                                         "type":  "string",
                                         "format":  "date-time"
                                     },
                       "updatedAt":  {
                                         "type":  "string",
                                         "format":  "date-time"
                                     },
                       "retrievalTerms":  {
                                              "type":  "array",
                                              "minItems":  1,
                                              "maxItems":  500,
                                              "uniqueItems":  true,
                                              "items":  {
                                                            "type":  "string",
                                                            "minLength":  1,
                                                            "maxLength":  160
                                                        }
                                          }
                   },
    "required":  [
                     "schemaVersion",
                     "id",
                     "status",
                     "title",
                     "language",
                     "tags",
                     "topics",
                     "sourceRefs",
                     "claims",
                     "relationships",
                     "review",
                     "createdAt",
                     "updatedAt",
                     "retrievalTerms"
                 ],
    "allOf":  [
                  {
                      "if":  {
                                 "properties":  {
                                                    "status":  {
                                                                   "const":  "approved"
                                                               }
                                                }
                             },
                      "then":  {
                                   "type":  "object",
                                   "properties":  {
                                                      "review":  {
                                                                     "type":  "object",
                                                                     "properties":  {
                                                                                        "humanReviewStatus":  {
                                                                                                                  "const":  "approved"
                                                                                                              },
                                                                                        "approvedBy":  {
                                                                                                           "type":  "string",
                                                                                                           "minLength":  1
                                                                                                       },
                                                                                        "approvedAt":  {
                                                                                                           "type":  "string",
                                                                                                           "format":  "date-time"
                                                                                                       }
                                                                                    }
                                                                 }
                                                  }
                               }
                  }
              ]
}
