{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-grounded-assistant.example/contracts/gateway-callback-outbox/v1",
  "title": "Gateway callback outbox record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^gatewaycallback_[a-f0-9]{32}$" },
    "jobId": { "type": "string", "pattern": "^gatewayjob_[a-f0-9]{32}$" },
    "callerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "callbackUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
    "payload": { "type": "object", "additionalProperties": false, "properties": { "schemaVersion": { "const": 1 }, "callbackId": { "type": "string", "pattern": "^gatewaycallback_[a-f0-9]{32}$" }, "requestId": { "type": "string", "minLength": 1, "maxLength": 128 }, "jobId": { "type": "string", "pattern": "^gatewayjob_[a-f0-9]{32}$" }, "conversationId": { "type": "string", "minLength": 1, "maxLength": 128 }, "userId": { "type": "string", "minLength": 1, "maxLength": 128 }, "turn": { "type": "object", "additionalProperties": false, "properties": { "status": { "enum": ["completed", "temporarily_unavailable"] }, "text": { "type": "string", "minLength": 1, "maxLength": 20000 }, "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" }, "completedAt": { "type": "string", "format": "date-time" } }, "required": ["status", "text", "language", "completedAt"] }, "sources": { "type": "object", "additionalProperties": false, "properties": { "available": { "type": "boolean" }, "expansionToken": { "type": ["string", "null"], "pattern": "^expand_[A-Za-z0-9_-]{43}$" } }, "required": ["available", "expansionToken"] } }, "required": ["schemaVersion", "callbackId", "requestId", "jobId", "conversationId", "userId", "turn", "sources"] },
    "status": { "enum": ["pending", "delivering", "retry_wait", "delivered", "terminal_failed"] },
    "attemptCount": { "type": "integer", "minimum": 0, "maximum": 10 },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "nextAttemptAt": { "type": "string", "format": "date-time" },
    "leaseExpiresAt": { "type": ["string", "null"], "format": "date-time" },
    "lastStatusCode": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
    "lastFailureCategory": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "required": ["schemaVersion", "id", "jobId", "callerId", "callbackUrl", "payload", "status", "attemptCount", "maxAttempts", "nextAttemptAt", "leaseExpiresAt", "lastStatusCode", "lastFailureCategory", "createdAt", "updatedAt", "expiresAt"]
}
