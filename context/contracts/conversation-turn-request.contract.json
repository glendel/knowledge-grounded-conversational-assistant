{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-grounded-assistant.example/contracts/conversation-turn-request/v1",
  "title": "Conversation turn request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "conversationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "messageId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requestedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["schemaVersion", "requestId", "conversationId", "userId", "messageId", "requestedAt"]
}
