{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-grounded-assistant.example/contracts/knowledge-relationship-map/v1",
  "title": "Approved Knowledge Base relationship map",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "knowledgeVersion": { "type": "string", "pattern": "^knowledge-release_[a-f0-9]{16,64}$" },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fromDocumentId": { "type": "string", "pattern": "^knowledge_[a-z0-9-]{3,80}$" },
          "type": { "enum": ["related_to", "prerequisite_for", "clarifies", "supersedes", "conflicts_with"] },
          "targetDocumentId": { "type": "string", "pattern": "^knowledge_[a-z0-9-]{3,80}$" },
          "evidenceClaimIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^claim_[a-z0-9-]{3,80}$" } }
        },
        "required": ["fromDocumentId", "type", "targetDocumentId", "evidenceClaimIds"]
      }
    }
  },
  "required": ["schemaVersion", "knowledgeVersion", "relationships"]
}
