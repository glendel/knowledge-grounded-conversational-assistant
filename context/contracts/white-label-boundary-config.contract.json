{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-grounded-assistant.example/contracts/white-label-boundary-config/v1",
  "title": "White-label boundary configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "disallowedCoreTerms": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "uniqueItems": true },
    "disallowedCorePathFragments": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "uniqueItems": true }
  },
  "required": ["schemaVersion", "disallowedCoreTerms", "disallowedCorePathFragments"]
}
