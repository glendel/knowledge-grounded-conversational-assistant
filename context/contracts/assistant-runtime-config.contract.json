{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-grounded-assistant.example/contracts/assistant-runtime-config/v1",
  "title": "Assistant and runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "assistantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "purpose": { "enum": ["support", "advisor", "seller", "onboarding", "internal_knowledge"] },
    "supportedLanguages": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" } },
    "tone": { "type": "string", "minLength": 1, "maxLength": 80 },
    "environment": { "enum": ["development", "test", "production"] },
    "dataDirectory": { "type": "string", "minLength": 1, "maxLength": 200 },
    "memoryRetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "maxMessageCharacters": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "logLevel": { "enum": ["debug", "info", "warn", "error"] }
  },
  "required": ["schemaVersion"]
}
