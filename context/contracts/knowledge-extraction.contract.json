{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-grounded-assistant.example/contracts/knowledge-extraction/v1",
  "title": "Sanitized reproducible extraction artifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^extraction_[a-f0-9]{16,64}$" },
    "sourceId": { "type": "string", "pattern": "^source_[a-f0-9]{16,64}$" },
    "sourceContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactRelativePath": { "type": "string", "minLength": 1, "maxLength": 500 },
    "extractor": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 100 }, "version": { "type": "string", "minLength": 1, "maxLength": 100 } }, "required": ["id", "version"] },
    "status": { "enum": ["completed", "needs_review"] },
    "warnings": { "type": "array", "maxItems": 1000, "items": { "type": "string", "maxLength": 500 } },
    "redactionSummary": { "type": "object", "additionalProperties": false, "properties": { "total": { "type": "integer", "minimum": 0 }, "byKind": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } } }, "required": ["total", "byKind"] },
    "segments": { "type": "array", "minItems": 1, "maxItems": 25000, "items": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string", "pattern": "^segment_[a-f0-9]{16,64}$" }, "location": { "type": "string", "minLength": 1, "maxLength": 500 }, "text": { "type": "string", "minLength": 1, "maxLength": 50000 }, "redactionFindingCount": { "type": "integer", "minimum": 0 }, "redactionKinds": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } } }, "required": ["id", "location", "text", "redactionFindingCount", "redactionKinds"] } },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["schemaVersion", "id", "sourceId", "sourceContentSha256", "artifactRelativePath", "extractor", "status", "warnings", "redactionSummary", "segments", "createdAt"]
}
