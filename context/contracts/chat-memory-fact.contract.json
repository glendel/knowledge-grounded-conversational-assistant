{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-grounded-assistant.example/contracts/chat-memory-fact/v1",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$" },
    "kind": { "enum": ["preferred_name"] }, "value": { "type": "string", "minLength": 1, "maxLength": 80 }, "sourceTurnId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$" },
    "status": { "enum": ["active", "superseded"] }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["schemaVersion", "id", "kind", "value", "sourceTurnId", "status", "createdAt", "updatedAt"]
}
