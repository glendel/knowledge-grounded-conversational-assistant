{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-grounded-assistant.example/contracts/provider-prose-qualification-dataset/v1",
  "title": "Provider prose qualification dataset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$" },
    "capability": { "const": "conversation_generation" },
    "cases": { "type": "array", "minItems": 4, "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$" }, "language": { "enum": ["es", "en"] }, "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 }, "expectedCharacteristics": { "type": "array", "minItems": 2, "items": { "enum": ["natural_prose", "follows_instruction", "bounded_output", "safe_uncertainty" ] }, "uniqueItems": true } }, "required": ["id", "language", "prompt", "expectedCharacteristics"] } },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["schemaVersion", "id", "capability", "cases", "createdAt"]
}
