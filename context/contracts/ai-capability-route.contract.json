{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-grounded-assistant.example/contracts/ai-capability-route/v1",
  "title": "AI capability route",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "capability": { "const": "conversation_generation" },
    "primaryLaneId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "maxOperationMs": { "type": "integer", "minimum": 1000, "maximum": 900000 },
    "fallbackLaneIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }, "uniqueItems": true }
  },
  "required": ["schemaVersion", "capability", "primaryLaneId", "maxOperationMs", "fallbackLaneIds"]
}
