{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-grounded-assistant.example/contracts/prose-generation-request/v1",
  "title": "Prose generation request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "capability": { "const": "conversation_generation" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "messages": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "object", "additionalProperties": false, "properties": { "role": { "enum": ["system", "user", "assistant"] }, "content": { "type": "string", "minLength": 1, "maxLength": 100000 } }, "required": ["role", "content"] } },
    "generation": { "type": "object", "additionalProperties": false, "properties": { "languageHint": { "type": ["string", "null"], "minLength": 2, "maxLength": 16 }, "maxOutputCharacters": { "type": "integer", "minimum": 1, "maximum": 100000 }, "temperature": { "type": ["number", "null"], "minimum": 0, "maximum": 2 } }, "required": ["languageHint", "maxOutputCharacters", "temperature"] }
  },
  "required": ["schemaVersion", "requestId", "capability", "requestedAt", "messages", "generation"]
}
